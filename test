    local currentRank = v1.Rank or 1
    local maxZoneName, maxZoneData = getMaxOwnedZoneInCurrentWorld()
    local currentZoneNum = maxZoneData and maxZoneData.ZoneNumber or 0
    local effectiveMaxZone = math.max(config.MaxZone or 0, currentZoneNum)
    return config.StopQuestsUntilMaxZone and currentRank >= 6 and currentZoneNum < effectiveMaxZone
end

