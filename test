local nearest10 = {}
for i = 1, 10 do
    nearest10[i] = {model = nil, dist = 999999, uid = nil}
end

local function resetNearest()
    for i = 1, 10 do
        local entry = nearest10[i]
        entry.model = nil
        entry.dist = 999999
        entry.uid = nil
    end
end

local function insertNearest(model, dist, uid)
    if dist >= nearest10[10].dist then return end
    
    local insertPos = 10
    for i = 9, 1, -1 do
        if dist < nearest10[i].dist then
            insertPos = i
        else
            break
        end
    end
    
    for i = 10, insertPos + 1, -1 do
        local current = nearest10[i]
        local prev = nearest10[i - 1]
        current.model = prev.model
        current.dist = prev.dist
        current.uid = prev.uid
    end
    
    local target = nearest10[insertPos]
    target.model = model
    target.dist = dist
    target.uid = uid
end

