local function waitGameLoad()
    if not game:IsLoaded() then
        game.Loaded:Wait()
    end
    repeat task.wait() until Players.LocalPlayer
    LocalPlayer = Players.LocalPlayer
    repeat task.wait() until LocalPlayer.Character
    LocalPlayer.Character:WaitForChild("HumanoidRootPart", 30)
    repeat task.wait() until LocalPlayer:FindFirstChild("PlayerGui")
    
    local playerGui = LocalPlayer.PlayerGui
    
    local function isHudActive()
        local activeCount = 0
        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Enabled then
                local nameLower = string.lower(gui.Name)
                if string.find(nameLower, "hud") or nameLower == "hud" or nameLower == "main" or nameLower == "play" then
                    return true
                end
                activeCount = activeCount + 1
            end
        end
        return activeCount >= 3
    end
    
    if isHudActive() then
        return
    end
    
    local function isLoadingActive()
        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Enabled then
                local nameLower = string.lower(gui.Name)
                if nameLower ~= "hud" and nameLower ~= "chat" and nameLower ~= "bubblechat" 
                   and nameLower ~= "touchgui" and nameLower ~= "screengui" and nameLower ~= "freecamera"
                   and not string.find(nameLower, "hud") and nameLower ~= "ps99_infopanel" then
                    
                    local hasFullScreen = false
                    for _, child in ipairs(gui:GetDescendants()) do
                        if child:IsA("Frame") or child:IsA("ImageLabel") or child:IsA("ImageButton") then
                            local success, isFull = pcall(function()
                                if not child.Visible then return false end
                                if child.Size.X.Scale < 0.99 or child.Size.Y.Scale < 0.99 then return false end
                                if child:IsA("Frame") and child.BackgroundTransparency >= 0.95 then return false end
                                if (child:IsA("ImageLabel") or child:IsA("ImageButton")) and child.ImageTransparency >= 0.95 and child.BackgroundTransparency >= 0.95 then return false end
                                return true
                            end)
                            if success and isFull then
                                hasFullScreen = true
                                break
                            end
                        end
                    end
                    if hasFullScreen then
                        return true
                    end
                end
            end
        end
        return false
    end
    
    local startWait = tick()
    local foundLoading = false
    while tick() - startWait < 5 do
        if isHudActive() then
            return
        end
        if isLoadingActive() then
            foundLoading = true
            break
        end
        task.wait(0.1)
    end
    
    if foundLoading then
        local loopStart = tick()
        while isLoadingActive() do
            if isHudActive() or (tick() - loopStart > 15) then
                break
            end
            task.wait(0.5)
        end
    end
    task.wait(1.5)
end

