                if string.find(childName, "|") then
                    local parts = string.split(childName, "|")
                    cleanChildName = string.gsub(parts[#parts], "^%s*(.-)%s*$", "%1")
                end
                if cleanChildName == cleanName or string.find(childName, cleanName, 1, true) then
                    return child
                end
            end
        end
    end
    return nil
