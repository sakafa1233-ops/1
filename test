local _maxZoneCache = {
    world = nil,
    t = 0,
    all = nil,
    farm = nil
}

getMaxOwnedZoneInCurrentWorld = function(includeChestZones)
    local currentWorld = getCurrentWorld()
    local cacheKey = includeChestZones and "all" or "farm"

    if _maxZoneCache.world == currentWorld and _maxZoneCache[cacheKey] and (tick() - _maxZoneCache.t) < 10 then
        local cachedData = _maxZoneCache[cacheKey]
        return cachedData.name, cachedData.data
    end

    local highestZoneNum  = -1
    local highestZoneName = nil
    local highestZoneData = nil

    local v1 = Save.Get()
    if v1 and v1.UnlockedZones then
        pcall(function()
            for zoneName, isOwned in pairs(v1.UnlockedZones) do
                if isOwned == true then
                    local zoneData = nil
                    pcall(function() zoneData = Directory.Zones[zoneName] end)
                    if zoneData then
                        local zoneWorld = zoneData.WorldNumber or 1
                        if zoneWorld == currentWorld then
                            local nameLower = string.lower(tostring(zoneName))
                            if not string.find(nameLower, "vip") then
                                local zoneNum = zoneData.ZoneNumber
                                if zoneNum and zoneNum > highestZoneNum then
                                    highestZoneNum  = zoneNum
                                    highestZoneName = zoneName
                                    highestZoneData = zoneData
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    if highestZoneName then
        _maxZoneCache.world = currentWorld
        _maxZoneCache.t     = tick()
        _maxZoneCache[cacheKey] = {name = highestZoneName, data = highestZoneData}
        return highestZoneName, highestZoneData
    end

    local fbName, fbData = nil, nil
    pcall(function()
        fbName, fbData = ZoneCmds.GetMaxOwnedZone()
    end)
    if fbName and fbData and (fbData.WorldNumber or 1) == currentWorld and not string.find(string.lower(tostring(fbName)), "vip") then
        local actuallyOwned = false
        pcall(function()
            actuallyOwned = ZoneCmds.Owns(fbName)
        end)
        if actuallyOwned then
            _maxZoneCache.world = currentWorld
            _maxZoneCache.t     = tick()
            _maxZoneCache[cacheKey] = {name = fbName, data = fbData}
            return fbName, fbData
        end
    end

    local fallbackZone = "Spawn"
    if currentWorld == 2 then fallbackZone = "Tech Spawn"
    elseif currentWorld == 3 then fallbackZone = "Void Spawn"
    elseif currentWorld == 4 then fallbackZone = "Fantasy Spawn"
    end
        local spawnData = getZoneDataSafely(fallbackZone)
    _maxZoneCache.world = currentWorld
    _maxZoneCache.t     = tick()
    _maxZoneCache[cacheKey] = {name = fallbackZone, data = spawnData}
    return fallbackZone, spawnData
end

local function isInFirst10ZonesOfCurrentWorld()
    local isFirst10 = false
    pcall(function()
        local currentWorld = getCurrentWorld()
        if currentWorld == 1 then return end 
        local maxZoneName, maxZoneData = getMaxOwnedZoneInCurrentWorld(true)
        local currentZone = MapCmds.GetCurrentZone()
        
        local function checkZone(zoneName)
            if not zoneName then return false end
            local zData = getZoneDataSafely(zoneName)
            if not zData then return false end
            
            local w = zData.WorldNumber or 1
            if w ~= currentWorld then return false end
            
            local minZoneNum = 999999
            for _, d in pairs(Directory.Zones) do
                local dw = d.WorldNumber or 1
                if dw == currentWorld then
                    local num = d.ZoneNumber
                    if num and num < minZoneNum then
                        minZoneNum = num
                    end
                end
            end
            
            if zData.ZoneNumber and minZoneNum ~= 999999 then
                local relativeNum = zData.ZoneNumber - minZoneNum + 1
                if relativeNum >= 1 and relativeNum <= 10 then
                    return true
                end
            end
            return false
        end
        
        if checkZone(maxZoneName) then
            isFirst10 = true
        end
    end)
    return isFirst10
end

