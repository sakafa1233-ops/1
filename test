    local cleanName = string.lower(tostring(zoneName))
    if string.find(cleanName, "|") then
        local parts = string.split(cleanName, "|")
        cleanName = string.gsub(parts[#parts], "^%s*(.-)%s*$", "%1")
    end

    for _, mapName in ipairs(MAP_NAMES) do
        local mapObj = workspace:FindFirstChild(mapName)
        if mapObj then
            for _, child in ipairs(mapObj:GetChildren()) do
                local childName = string.lower(child.Name)
