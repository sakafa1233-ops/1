local function checkCanBuySlots()
    local v1 = Save.Get()
    if not v1 then return false, 0, 0, false, 0, 0 end
    
    local activeCalcPetSlotPrice = CalcPetSlotPrice
    if not activeCalcPetSlotPrice then
        pcall(function()
            activeCalcPetSlotPrice = require(game:GetService("ReplicatedStorage"):WaitForChild("Library", 5):WaitForChild("Balancing", 5):WaitForChild("CalcPetSlotPrice", 5))
        end)
    end
    
    local activeCalcEggSlotPrice = CalcEggSlotPrice
