local lastAntiStuckCheck = 0
local lastHrpPosition = nil
local positionStuckStartTime = 0
local zoneStuckStartTime = 0
local lastZoneNameForStuck = nil

local function handleAntiStuck()
    if isCurrentlyTraveling() then return end
    
    local now = tick()
    if now - lastAntiStuckCheck < 2.5 then return end
    lastAntiStuckCheck = now

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if hrp.Position.Y < -100 or hrp.Position.Y > 1000 then
        local maxZoneName = getMaxOwnedZoneInCurrentWorld()
        if maxZoneName then
            pcall(function() teleportToZone(maxZoneName) end)
        else
            pcall(function() char:BreakJoints() end)
        end
        return
    end

    local currentPos = hrp.Position
    if lastHrpPosition and (currentPos - lastHrpPosition).Magnitude < 3 then
        if positionStuckStartTime == 0 then
            positionStuckStartTime = now
        elseif now - positionStuckStartTime > 20 then
            local maxZoneName = getMaxOwnedZoneInCurrentWorld()
            if maxZoneName then
                pcall(function() teleportToZone(maxZoneName) end)
                pcall(function() if not AutoFarmCmds.IsEnabled() then AutoFarmCmds.Enable() end end)
            end
            pcall(forceCloseTab)
            positionStuckStartTime = 0
        end
    else
        lastHrpPosition = currentPos
        positionStuckStartTime = 0
    end

    local maxZoneName, maxZoneData = getMaxOwnedZoneInCurrentWorld(true)
    if maxZoneData and maxZoneData.ZoneNumber then
        if lastZoneNameForStuck ~= maxZoneName then
            lastZoneNameForStuck = maxZoneName
            zoneStuckStartTime = now
        elseif now - zoneStuckStartTime > 15 then
            zoneStuckStartTime = now
            _maxZoneCache.t = 0
            _maxZoneCache.world = nil
            
            local currentZoneNum = maxZoneData.ZoneNumber
            for offset = 1, 3 do
                local targetNum = currentZoneNum + offset
                local targetName = ZonesUtil.GetZoneFromNumber(targetNum)
                if targetName then
                    pcall(function() Network.Invoke("Zones_RequestPurchase", targetName) end)
                    pcall(function()
                        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("Network") and game:GetService("ReplicatedStorage").Network:FindFirstChild("Zones_RequestPurchase")
                        if remote and remote:IsA("RemoteFunction") then
                            remote:InvokeServer(targetName)
                        end
                    end)
                end
            end
            
            if maxZoneName then
                pcall(function() teleportToZone(maxZoneName) end)
