local function shouldIgnoreBreakable(bId, currentZone)
    local nameLower = string.lower(bId or "")
    if string.find(nameLower, "vip") then
        return true
    end
    
    if string.find(nameLower, "boss") or string.find(nameLower, "chest") or string.find(nameLower, "giant") then
        
        local zoneData = getZoneDataSafely(currentZone)
        local zoneNum = zoneData and zoneData.ZoneNumber
        if isRawChestZone(currentZone, zoneNum) then
