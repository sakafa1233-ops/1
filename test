    if suppressedGuis[child] then return end
    if not (child:IsA("ScreenGui") or child:IsA("BillboardGui")) then return end
    local name = child.Name
    local lower = string.lower(name)
    if string.find(lower, "autorank") or name == "CustomAutoRankUI" then return end
    if shouldSuppressGui(name) then
        suppressedGuis[child] = true
        autoClickGuiButtons(child)
        pcall(function()
            child.Enabled = false
            child:GetPropertyChangedSignal("Enabled"):Connect(function()
                if child.Enabled then child.Enabled = false end
            end)
        end)
    end
end

