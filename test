    local T_BEST_LUCKYBLOCK = Q.BEST_LUCKYBLOCK or 44
    local T_RANDOM_LUCKYBLOCK = Q.RANDOM_LUCKYBLOCK or 71

    if questType == T_COIN_JAR or questType == T_BEST_COIN_JAR or questType == T_RANDOM_COIN_JAR then
        allowedIds = {"Basic Coin Jar", "Coin Jar"}
        keywordMatch = ""
        remoteName = "CoinJar_Spawn"
    elseif questType == T_COMET or questType == T_BEST_COMET or questType == T_RANDOM_COMET then
        allowedIds = {"Comet"}
        keywordMatch = ""
        remoteName = "Comet_Spawn"
    elseif questType == T_PINATA or questType == T_BEST_PINATA or questType == T_RANDOM_PINATA then
        allowedIds = {"Mini Pinata", "Pinata"}
        keywordMatch = "pinata"
        remoteName = "MiniPinata_Consume"
    elseif questType == T_LUCKYBLOCK or questType == T_BEST_LUCKYBLOCK or questType == T_RANDOM_LUCKYBLOCK then
        allowedIds = {"Mini Lucky Block", "Lucky Block"}
        keywordMatch = "lucky"
        remoteName = "MiniLuckyBlock_Consume"
    end
    
