local function canAffordEgg(eggNumber, amount)
    local eggData = EggsUtil.GetByNumber(eggNumber)
    if not eggData then return false end
    
    local price = 0
    pcall(function()
        if CalcEggPricePlayer then
            price = CalcEggPricePlayer(eggData)
        else
            local fallbackPricePlayer = require(game:GetService("ReplicatedStorage").Library.Balancing.CalcEggPricePlayer)
            price = fallbackPricePlayer(eggData)
        end
    end)
    
    local currency = eggData.currency or "Coins"
    local balance = CurrencyCmds.Get(currency) or 0
    return balance >= price * (amount or 1)
end

local function executePetConversion()
    local hasQuest, activeGoal = hasActivePetConversionQuest()
    if not hasQuest then return false end
    
    local Goals = Quests and Quests.Goals or {}
    local TYPE_GOLD_PET = Goals.GOLD_PET or 4
    local TYPE_RAINBOW_PET = Goals.RAINBOW_PET or 5
    local TYPE_BEST_GOLD_PET = Goals.BEST_GOLD_PET or 40
    local TYPE_BEST_RAINBOW_PET = Goals.BEST_RAINBOW_PET or 41
    
    local qType = activeGoal.Type
    local isRainbowQuest = (qType == TYPE_RAINBOW_PET or qType == TYPE_BEST_RAINBOW_PET)
    local isBestOnly = (qType == TYPE_BEST_GOLD_PET or qType == TYPE_BEST_RAINBOW_PET)
    
    local needed = math.max(1, (activeGoal.Amount or 1) - (activeGoal.Progress or 0))
    
    local v1 = Save.Get()
    if not v1 or not v1.Inventory or not v1.Inventory.Pet then return false end
    
    local bestPetIds = {}
    if isBestOnly then
        local maxAvailableEgg = v1.MaximumAvailableEgg or 1
        local eggData = EggsUtil.GetByNumber(maxAvailableEgg)
        if eggData and eggData.pets then
            for _, petEntry in ipairs(eggData.pets) do
                local petId = petEntry[1]
                if petId then
                    bestPetIds[petId] = true
                end
            end
        end
    end
    
    local equipped = {}
    pcall(function()
        if PetNetworking then
            equipped = PetNetworking.EquippedPets() or {}
        end
    end)
    
    local normalGroups = {} 
    local goldenGroups = {} 
    local normalTotals = {} 
    local goldenTotals = {} 
    
    for k, v in pairs(v1.Inventory.Pet) do
        local petInstance = nil
        pcall(function()
            if PetItem then
                petInstance = PetItem:Get(k) or PetItem:Find(k)
            end
        end)
        
        if petInstance then
            local petId = petInstance:GetId()
            local qualifies = true
            if isBestOnly then
                qualifies = bestPetIds[petId] == true
            end
            
            if qualifies then
                local isEquipped = equipped[k] ~= nil
                local isLocked = false
                pcall(function() isLocked = petInstance:IsLocked() end)
                
                local isHugeOrRare = false
                pcall(function()
                    if petInstance:GetExclusiveLevel() > 0 then
                        isHugeOrRare = true
                    end
                end)
                
                if not isEquipped and not isLocked and not isHugeOrRare and not petInstance:IsShiny() then
                    local qty = 1
                    pcall(function()
                        qty = petInstance:GetAmount() or 1
                    end)
                    
                    if petInstance:IsNormal() then
                        normalGroups[petId] = normalGroups[petId] or {}
                        table.insert(normalGroups[petId], { uid = k, qty = qty })
                        normalTotals[petId] = (normalTotals[petId] or 0) + qty
                    elseif petInstance:IsGolden() then
                        goldenGroups[petId] = goldenGroups[petId] or {}
                        table.insert(goldenGroups[petId], { uid = k, qty = qty })
                        goldenTotals[petId] = (goldenTotals[petId] or 0) + qty
                    end
                end
            end
        end
    end
    
    local targetMachine = nil
    local targetUID = nil
    local toCreate = 0
    
    if isRainbowQuest then
        
        for petId, stacks in pairs(goldenGroups) do
            local bestGoldStack = nil
            for _, s in ipairs(stacks) do
                if not bestGoldStack or s.qty > bestGoldStack.qty then
                    bestGoldStack = s
                end
            end
            if bestGoldStack and bestGoldStack.qty >= 10 then
                targetMachine = "RainbowMachine"
                targetUID = bestGoldStack.uid
                local maxCreate = math.floor(bestGoldStack.qty / 10)
                toCreate = math.min(needed, maxCreate)
                break
            end
        end
        
        if not targetUID then
            for petId, stacks in pairs(normalGroups) do
                local bestNormalStack = nil
                for _, s in ipairs(stacks) do
                    if not bestNormalStack or s.qty > bestNormalStack.qty then
                        bestNormalStack = s
                    end
                end
                if bestNormalStack and bestNormalStack.qty >= 10 then
                    targetMachine = "GoldMachine"
                    targetUID = bestNormalStack.uid
                    toCreate = math.floor(bestNormalStack.qty / 10)
                    break
                end
            end
        end
        
    else
        
        for petId, stacks in pairs(normalGroups) do
            local bestNormalStack = nil
            for _, s in ipairs(stacks) do
                if not bestNormalStack or s.qty > bestNormalStack.qty then
                    bestNormalStack = s
                end
            end
            if bestNormalStack and bestNormalStack.qty >= 10 then
                targetMachine = "GoldMachine"
                targetUID = bestNormalStack.uid
                local maxCreate = math.floor(bestNormalStack.qty / 10)
                toCreate = math.min(needed, maxCreate)
                break
            end
        end
    end
    
    if not targetUID or toCreate <= 0 then
        return false 
    end
    
    local remoteName = targetMachine .. "_Activate"
        
    local success = false
    pcall(function()
        Network.Invoke(remoteName, targetUID, toCreate)
        success = true
    end)
    
    if success then
                task.wait(0.5) 
        return true
    else
            end
    
    return false
end

local function getTargetEnchantsUids(targetList, maxEnchants)
    local selectedUids = {}
    local selectedTypesAndTiers = {}
    local usedCounts = {} 
    
    local MasteryCmds = nil
    pcall(function() MasteryCmds = require(game:GetService("ReplicatedStorage").Library.Client.MasteryCmds) end)
    
    local allEnchants = {}
    pcall(function()
        if EnchantItem then
            allEnchants = EnchantItem:All() or {}
        end
    end)
    
    local enchantGroups = {}
    for uid, item in pairs(allEnchants) do
        local ok, id = pcall(function() return item:GetId() end)
        if ok and id then
            enchantGroups[id] = enchantGroups[id] or {}
            local tier = 1
            pcall(function() tier = item:GetTier() or 1 end)
            local qty = 1
            pcall(function() qty = item:GetAmount() or 1 end) 
            table.insert(enchantGroups[id], { uid = uid, tier = tier, qty = qty })
        end
    end
    
    for id, list in pairs(enchantGroups) do
        table.sort(list, function(a, b) return a.tier > b.tier end)
    end
    
    local limit = math.min(#targetList, maxEnchants)
    for i = 1, limit do
        local targetType = targetList[i]
        local group = enchantGroups[targetType]
        local found = false
        if group then
            for _, entry in ipairs(group) do
                local currentUsed = usedCounts[entry.uid] or 0
                if currentUsed < entry.qty then
                    
                    local canUse = true
                    pcall(function()
                        if MasteryCmds and MasteryCmds.CanUseEnchant then
                            local ok = MasteryCmds.CanUseEnchant(entry.tier)
                            if ok == false then
                                canUse = false
                            end
                        end
                    end)
                    
                    if canUse then
                        usedCounts[entry.uid] = currentUsed + 1
                        table.insert(selectedUids, entry.uid)
                        table.insert(selectedTypesAndTiers, { type = targetType, tier = entry.tier })
                        found = true
                        break
                    end
                end
            end
        end
        if not found then
            table.insert(selectedUids, "none")
            table.insert(selectedTypesAndTiers, { type = "none", tier = 0 })
        end
    end
    
    return selectedUids, selectedTypesAndTiers, limit
end

