                        table.insert(candidateItems, { id = itemId, uid = uid })
                    end
                end
            end
        end)
    end
    
    for _, candidate in ipairs(candidateItems) do
        local isTarget = false
        local cId = candidate.id
        
        for _, tId in ipairs(allowedIds) do
            if cId == tId or string.lower(cId) == string.lower(tId) then
