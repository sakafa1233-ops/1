    local function cleanVisuals(v)
        local inThings = false
        local folderName = nil
        
        local p = v
        while p and p.Parent do
            if p.Parent.Name == "__THINGS" then
                inThings = true
                folderName = p.Name
                break
            end
            p = p.Parent
        end
        
        if inThings then
            local hide = false
            if folderName == "Pets" then
                hide = config.HidePets
            elseif folderName == "Breakables" then
                hide = config.HideBreakables
            elseif folderName == "Orbs" then
                hide = config.HideOrbs
            elseif folderName == "Lootbags" then
                hide = config.HideLootbags
            elseif folderName ~= "Instances" then
                hide = true
            end
            
            if hide then
                hideVisual(v)
                return
            end
        else
            
            local isMap = false
            local p2 = v
            while p2 and p2.Parent do
                local name = p2.Parent.Name
                if name == "Map" or name == "Map2" or name == "Map3" or name == "Map4" then
                    isMap = true
                    break
                end
                p2 = p2.Parent
            end
            
            if isMap and config.HideMap then
                hideVisual(v)
                return
            end

            if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SelectionBox") or v:IsA("SelectionSphere") then
                pcall(function() v:Destroy() end)
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Sparkles") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Beam") or v:IsA("Highlight") or v:IsA("Light") then
                pcall(function() v.Enabled = false end)
            elseif v:IsA("BillboardGui") or v:IsA("ScreenGui") or v:IsA("SurfaceGui") then
                if v.Name ~= "PS99_MiniPanel" and v.Name ~= "PS99_BrownOverlay" then
                    pcall(function() v.Enabled = false end)
                end
            elseif v:IsA("BasePart") or v:IsA("MeshPart") then
                pcall(function()
                    v.Transparency = 1
                    v.CastShadow = false
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                end)
            end
        end
    end
    
