local function isCurrentlyTraveling()
    local isMainWorld = currentPlaceIsMainWorld
    if not isMainWorld then
        return true
    end
    if getgenv().LastTeleportTime and (tick() - getgenv().LastTeleportTime) < 45 then
        return true
    end
    return false
end

local FRAME_BUDGET_MS = 8 

local function hasTimeBudget(startTime)
    if config.Fps and config.Fps <= 15 then
        return true
    end
    return (tick() - startTime) * 1000 < FRAME_BUDGET_MS
end

