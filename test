            local save = Save and Save.Get()
            if save and save.Inventory and save.Inventory.Misc then
                for uid, mData in pairs(save.Inventory.Misc) do
                    if mData then
                        local itemId = tostring(mData.id or mData.Id or "")
                        if string.find(itemId, "Flag", 1, true) or string.find(itemId, "flag", 1, true) then
                            local amount = mData._am or mData.Amount or 1
                            table.insert(flagItems, {
                                id = itemId,
                                uid = uid,
                                amount = amount
                            })
                        end
                    end
                end
            end
        end)
    end
    
    local placedCount = 0
    
    for _, flagData in ipairs(flagItems) do
        if placedCount >= needed then break end
        local amountToTry = math.min(needed - placedCount, flagData.amount or 1)
        
        for i = 1, amountToTry do
            local success = false
            pcall(function()
                local res1 = Network.Invoke("FlexibleFlags_Consume", flagData.id, flagData.uid, 1)
                if res1 == true or (res1 ~= nil and res1 ~= false) then
                    success = true
                end
            end)
            
            if not success then
                pcall(function()
                    local res1 = Network.Invoke("FlexibleFlags_Consume", flagData.id, flagData.uid)
                    if res1 == true or (res1 ~= nil and res1 ~= false) then
                        success = true
                    end
                end)
            end
            
            if success then
                placedCount = placedCount + 1
                task.wait(0.3)
                if placedCount >= needed then break end
            end
        end
    end
    
    if placedCount < needed then
        for _, flagName in ipairs(FLAG_NAMES) do
            if placedCount >= needed then break end
            pcall(function()
                local Items = require(game:GetService("ReplicatedStorage").Library.Items)
                local miscItem = Items.Misc(flagName)
                if miscItem then
                    local count = 0
                    pcall(function() count = miscItem:CountAny() or 0 end)
                    if count > 0 then
                        local uid = nil
                        pcall(function() uid = miscItem:GetUID() end)
                        if uid then
                            local res = Network.Invoke("FlexibleFlags_Consume", flagName, uid, 1)
                            if res == true or (res ~= nil and res ~= false) then
                                placedCount = placedCount + 1
                                task.wait(0.3)
                            end
                        end
                    end
                end
            end)
        end
    end
    
    if placedCount > 0 then
        lastFlagPlacedTime = tick()
        return true
    end
    return false
end

local lastPotionUseTime = 0
local isConsumingPotion = false
local function handleUsePotionQuest(activeGoal)
    if not activeGoal or isConsumingPotion then return false end
    
    local needed = math.max(1, (activeGoal.Amount or 1) - (activeGoal.Progress or 0))
    if tick() - lastPotionUseTime < 0.5 then
        return false
    end
    
    isConsumingPotion = true
    lastPotionUseTime = tick()
    
    local targetPotionId = activeGoal.PotionID or activeGoal.PotionId or activeGoal.Potion or activeGoal.Item or activeGoal.Target
    if targetPotionId then
        local pStr = tostring(targetPotionId):lower()
        if pStr == "" or pStr == "any" or pStr == "all" or pStr == "potion" or pStr == "potions" then
            targetPotionId = nil
        end
    end
    
    local targetTierRaw = activeGoal.PotionTier or activeGoal.Tier or activeGoal.PotionTierNum or activeGoal.RequiredTier or activeGoal.TargetTier or activeGoal.MinTier or activeGoal.PotionTierID
    if not targetTierRaw and activeGoal.Title then
        targetTierRaw = tostring(activeGoal.Title):match("[Tt]ier%s+([%d%a]+)")
    end
    if not targetTierRaw and activeGoal.Desc then
        targetTierRaw = tostring(activeGoal.Desc):match("[Tt]ier%s+([%d%a]+)")
    end
    
    local goalTierNum = parseTierNumber(targetTierRaw)
    
    local potionItems = {}
    pcall(function()
        if not Inventory then
            pcall(function() Inventory = require(game:GetService("ReplicatedStorage").Library.Universal.Inventory) end)
        end
        if Inventory then
            local container = Inventory.Container(LocalPlayer)
            if container then
                local allItems = {}
                pcall(function()
                    for uid, item in pairs(container:All()) do
                        allItems[uid] = item
                    end
                end)
                if container._store and container._store._byUID then
                    for uid, item in pairs(container._store._byUID) do
                        allItems[uid] = item
                    end
                end
                
                for uid, item in pairs(allItems) do
                    if item and item._data then
                        local itemId = safeGetItemId(item) or ""
                        local isPotion = false
                        
                        if item.Class and item.Class.Name == "Potion" then
                            isPotion = true
                        elseif itemId ~= "" then
                            local Directory = nil
                            pcall(function() Directory = require(game:GetService("ReplicatedStorage").Library.Directory) end)
                            if Directory and Directory.Potions and Directory.Potions[itemId] then
                                isPotion = true
                            elseif string.find(itemId, "Potion", 1, true) then
                                isPotion = true
                            end
                        end
                        
                        if isPotion then
                            local itemUID = safeGetItemUID(item, uid)
                            local itemTier = nil
                            pcall(function() itemTier = item:GetTier() end)
                            if not itemTier and item._data then
                                itemTier = item._data.tn or item._data.Tier or item._data.tier
                            end
                            local itemTierNum = parseTierNumber(itemTier) or 1
                            
                            local amountInStack = 1
                            pcall(function() amountInStack = item:GetAmount() end)
                            if not amountInStack or amountInStack <= 0 then amountInStack = 1 end
                            
                            table.insert(potionItems, {
                                item = item,
                                id = itemId,
                                uid = itemUID,
                                tier = itemTierNum,
                                amount = amountInStack
                            })
                        end
                    end
                end
            end
        end
    end)
    
    if #potionItems == 0 then
        pcall(function()
            local save = Save and Save.Get()
            if save and save.Inventory and save.Inventory.Potion then
                for uid, pData in pairs(save.Inventory.Potion) do
                    if pData then
                        local itemId = tostring(pData.id or pData.Id or "")
                        local itemTierNum = parseTierNumber(pData.tn or pData.Tier or pData.tier) or 1
                        local amountInStack = pData._am or pData.Amount or pData._amount or 1
                        table.insert(potionItems, {
                            id = itemId,
                            uid = uid,
                            tier = itemTierNum,
                            amount = amountInStack
                        })
                    end
                end
            end
        end)
    end
    
    local matchingItems = {}
    for _, data in ipairs(potionItems) do
        local isMatch = true
        
        if targetPotionId and targetPotionId ~= "" then
            if not isPotionMatch(data.id, tostring(targetPotionId)) then
                isMatch = false
            end
        end
        
        if goalTierNum then
            if data.tier < goalTierNum then
                isMatch = false
            end
        end
        
        if isMatch then
            table.insert(matchingItems, data)
        end
    end
    
    table.sort(matchingItems, function(a, b)
        if goalTierNum then
            local aExact = (a.tier == goalTierNum)
            local bExact = (b.tier == goalTierNum)
            if aExact ~= bExact then
                return aExact
            end
        end
        return a.tier < b.tier
    end)
    
    local consumedCount = 0
    for _, data in ipairs(matchingItems) do
        if consumedCount >= needed then break end
        if data.uid then
            local amountToConsume = math.min(needed - consumedCount, data.amount or 1)
            local consumed = false
            
            pcall(function()
                local PotionCmds = require(game:GetService("ReplicatedStorage").Library.Client.PotionCmds)
                PotionCmds.Consume(data.uid, amountToConsume)
                consumed = true
            end)
            
            pcall(function()
                Network.Fire("Potions: Consume", data.uid, amountToConsume)
                consumed = true
            end)
            
            pcall(function()
                Network.Fire("Potions_Consume", data.uid, amountToConsume)
                consumed = true
            end)
            
            if consumed then
                consumedCount = consumedCount + amountToConsume
            end
        end
    end
    
    isConsumingPotion = false
    return consumedCount > 0
end

