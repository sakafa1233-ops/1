local function parseTierNumber(val)
    if not val then return nil end
    if type(val) == "number" then return val end
    local num = tonumber(val)
    if num then return num end
    
    local str = tostring(val):upper()
    local romanMap = {
        ["I"] = 1, ["II"] = 2, ["III"] = 3, ["IV"] = 4, ["V"] = 5,
        ["VI"] = 6, ["VII"] = 7, ["VIII"] = 8, ["IX"] = 9, ["X"] = 10,
        ["XI"] = 11, ["XII"] = 12
    }
    str = str:gsub("TIER", ""):gsub("%s+", "")
    if romanMap[str] then return romanMap[str] end
    
    local digits = str:match("%d+")
    if digits then return tonumber(digits) end
    
    return nil
end

local function safeGetItemUID(item, fallbackUid)
    if not item then return fallbackUid end
    local ok, uid = pcall(function() return item:GetUID() end)
    if ok and uid then return uid end
    if item._uid then return item._uid end
    if item.uid then return item.uid end
    return fallbackUid
end

local function safeGetItemId(item)
    if not item then return nil end
    
    local ok, id = pcall(function() return item:GetId() end)
    if ok and id then return tostring(id) end
    
    if item._id then return tostring(item._id) end
    if item.id then return tostring(item.id) end
    
    if item._data then
        if item._data.id then return tostring(item._data.id) end
        if item._data.Id then return tostring(item._data.Id) end
    end
    return nil
end

local function normalizePotionName(name)
    if not name then return "" end
    local s = tostring(name):lower()
    s = s:gsub("potions?", "")
    s = s:gsub("%s+", " ")
    s = s:gsub("^%s*(.-)%s*$", "%1")
    
    local suffix_patterns = {
        "%s+xii$", "%s+xi$", "%s+x$", "%s+ix$", "%s+viii$", "%s+vii$", "%s+vi$", "%s+v$", "%s+iv$", "%s+iii$", "%s+ii$", "%s+i$",
        "%s+%d+$"
    }
    for _, pattern in ipairs(suffix_patterns) do
        local new_s, count = s:gsub(pattern, "")
        if count > 0 then
            s = new_s
            break
        end
    end
    
    s = s:gsub("%s+", "")
    return s
end

local function isPotionMatch(itemId, potName)
    if not itemId then return false end
    if not potName or potName == "" then return true end
    
    local itemNorm = normalizePotionName(itemId)
    local potNorm = normalizePotionName(potName)
    
    if potNorm == "" or potNorm == "any" or potNorm == "all" or potNorm == "potion" or potNorm == "potions" then
        return true
    end
    
    if itemNorm == potNorm then return true end
    
    if potNorm == "lucky" and (string.find(itemNorm, "egg") or string.find(itemNorm, "hatch")) then
        return false
    end
    if itemNorm == "lucky" and (string.find(potNorm, "egg") or string.find(potNorm, "hatch")) then
        return false
    end
    
    if potNorm == "luckyeggs" or potNorm == "luckyegg" then
        return (string.find(itemNorm, "lucky") ~= nil and (string.find(itemNorm, "egg") ~= nil or string.find(itemNorm, "hatch") ~= nil))
    end
    
    if itemNorm == potNorm .. "potion" or potNorm == itemNorm .. "potion" then
        return true
    end
    
    if (itemNorm == "speed" and potNorm == "walkspeed") or (itemNorm == "walkspeed" and potNorm == "speed") then
        return true
    end
    
    if (itemNorm == "thecocktail" and potNorm == "cocktail") or (itemNorm == "cocktail" and potNorm == "thecocktail") then
        return true
    end
    
    return false
end

local function getActivePotionSeconds(activePotions, potName, serverTime)
    if not activePotions or type(activePotions) ~= "table" then return 0 end
    
    local highestRemaining = 0
    
    for key, tiers in pairs(activePotions) do
        if isPotionMatch(tostring(key), potName) then
            if type(tiers) == "table" then
                for tierStr, rem in pairs(tiers) do
                    local remSec = 0
                    if type(rem) == "number" then
                        if rem > 1000000000 then
                            remSec = rem - serverTime
                        else
                            remSec = rem
                        end
                    elseif type(rem) == "table" then
                        local t = rem.Expire or rem.Expiration or rem.EndTime or rem.Time or rem.Duration or rem.Seconds
                        if type(t) == "number" then
                            if t > 1000000000 then
                                remSec = t - serverTime
                            else
                                remSec = t
                            end
                        end
                    end
                    if remSec > highestRemaining then
                        highestRemaining = remSec
                    end
                end
            elseif type(tiers) == "number" then
                local remSec = (tiers > 1000000000) and (tiers - serverTime) or tiers
                if remSec > highestRemaining then
                    highestRemaining = remSec
                end
            end
        end
    end
    
    return math.max(0, highestRemaining)
end

