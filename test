local function findMatchingChestZone(breakableType)
    if not breakableType then return nil end
    local typeLower = string.lower(breakableType)
    local currentWorld = getCurrentWorld()
    
    if Directory and Directory.Zones then
        for zoneName, zoneData in pairs(Directory.Zones) do
            if zoneData and (zoneData.WorldNumber or 1) == currentWorld then
                local nameLower = string.lower(zoneName)
                
                local cleanName = string.gsub(nameLower, "island", "")
                cleanName = string.gsub(cleanName, "temple", "")
                cleanName = string.gsub(cleanName, "colosseum", "")
                cleanName = string.gsub(cleanName, "matrix", "")
                cleanName = string.gsub(cleanName, "spawn", "")
                cleanName = string.gsub(cleanName, "hub", "")
                cleanName = string.gsub(cleanName, "castle", "")
                cleanName = string.gsub(cleanName, "%s+", "") 
                
                local words = {}
                for w in string.gmatch(cleanName, "%a+") do
                    if string.len(w) >= 3 then
                        table.insert(words, w)
                    end
                end
                
                for _, w in ipairs(words) do
                    if string.find(typeLower, w, 1, true) then
                        return zoneName
                    end
                end
            end
        end
    end
    return nil
end

local function hasActiveChestQuestForZone(zoneName)
    if not zoneName then return false end
    local v1 = Save.Get()
    local goals = v1 and v1.Goals
    if goals then
        for _, g in pairs(goals) do
            if type(g) == "table" and g.Type == 1 and g.BreakableType then
                local targetZone = findMatchingChestZone(g.BreakableType)
                if targetZone == zoneName then
                    return true
                end
            end
        end
    end
    return false
end

