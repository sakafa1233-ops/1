local function isSpawnedItemActive()
    local THINGS = workspace:FindFirstChild("__THINGS")
    if not THINGS then return false end
    
    local maxZoneName = getMaxOwnedZoneInCurrentWorld()
    local farmPos = maxZoneName and getFarmPosition(maxZoneName)
    if not farmPos then return false end
    
    local function isNearFarm(pos)
        if not pos then return false end
        return (pos - farmPos).Magnitude <= NEAR_FARM_RANGE
    end
    
    local function isItemValid(v, nameOrAttribute)
        if not nameOrAttribute then return false end
        local lowerName = string.lower(tostring(nameOrAttribute))
        
        if string.find(lowerName, "giant", 1, true) then
            return false
        end
        
        local isMagic = string.find(lowerName, "magic", 1, true)
        
        local isJar = string.find(lowerName, "jar", 1, true) and not isMagic
        local isComet = string.find(lowerName, "comet", 1, true)
        local isPinata = string.find(lowerName, "pinata", 1, true)
        local isLucky = string.find(lowerName, "lucky", 1, true)
        
        if isJar then
            
            if v and v:IsA("Model") then
                local mode = nil
                pcall(function() mode = v.ModelStreamingMode end)
                if mode ~= Enum.ModelStreamingMode.Persistent then
                    return false
                end
            end
        end
        
        return isJar or isComet or isPinata or isLucky
    end

    local function getPart(v)
        if not v then return nil end
        if v:IsA("Model") then
            return v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
        elseif v:IsA("BasePart") then
            return v
        end
        return nil
    end

    local breakables = THINGS:FindFirstChild("Breakables")
    if breakables then
        for _, v in ipairs(breakables:GetChildren()) do
            local breakableId = v:GetAttribute("BreakableID")
            local primaryPart = getPart(v)
            if primaryPart and isNearFarm(primaryPart.Position) then
                if isItemValid(v, breakableId) or isItemValid(v, v.Name) then
                    return true
                end
            end
        end
    end
    
    local randomEvents = THINGS:FindFirstChild("RandomEvents")
    if randomEvents then
        for _, v in ipairs(randomEvents:GetChildren()) do
            local breakableId = v:GetAttribute("BreakableID")
            local primaryPart = getPart(v)
            if primaryPart and isNearFarm(primaryPart.Position) then
                if isItemValid(v, v.Name) or isItemValid(v, breakableId) then
                    return true
                end
            end
        end
    end
    
    for _, v in ipairs(THINGS:GetChildren()) do
        local breakableId = v:GetAttribute("BreakableID")
        local primaryPart = getPart(v)
        if primaryPart and isNearFarm(primaryPart.Position) then
            if isItemValid(v, breakableId) or isItemValid(v, v.Name) then
                return true
            end
        end
    end
    
    return false
end

