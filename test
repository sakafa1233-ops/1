local syncedEvents = {}
local function syncRandomEvent(event)
    if not event or not event.id or not event.uid then return end
    if syncedEvents[event.uid] then return end
    syncedEvents[event.uid] = true
    local remoteName = "Random Events: Request " .. event.id .. " Data"
    pcall(function()
        Network.Invoke(remoteName, event.uid)
    end)
end

local function checkAndSyncRandomEvents()
    if RandomEventCmds then
        pcall(function()
            for _, event in pairs(RandomEventCmds.GetActive()) do
                syncRandomEvent(event)
            end
        end)
    end
end

