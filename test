local lastHatchTime = 0
local lastPetConvertTime = 0
local isHatching = false
local lastEggBlockLog = 0
local lastDisableHatchFlagsTime = 0

local function handleEggHatching()
    local v1 = Save.Get()
    if not v1 then return end
    
    local goals = v1.Goals
    if not goals then return end
    
    local currentRank = v1.Rank or 1
    local maxZoneName, maxZoneData = getMaxOwnedZoneInCurrentWorld()
    local currentZoneNum = maxZoneData and maxZoneData.ZoneNumber or 0
    local effectiveMaxZone = math.max(config.MaxZone or 0, currentZoneNum)
    if config.StopQuestsUntilMaxZone and currentRank >= 6 and currentZoneNum < effectiveMaxZone then
        return
    end
    
    local goalsList = {}
    for k, v in pairs(goals) do
        if type(v) == "table" and v.Type then
            table.insert(goalsList, v)
        end
    end
    
    local Goals = Quests and Quests.Goals or {}
    local TYPE_EGG = Goals.EGG or 3
    local TYPE_BEST_EGG = Goals.BEST_EGG or 20
    local TYPE_HATCH_CUSTOM_EGG = Goals.HATCH_CUSTOM_EGG or 83
    local TYPE_HATCH_RARE_PET = Goals.HATCH_RARE_PET or 42
    
    local eggGoal = nil
    local hasPetQuest, petGoal = hasActivePetConversionQuest()
    
    for _, g in ipairs(goalsList) do
        local qType = g.Type
        if (qType == TYPE_EGG or qType == TYPE_BEST_EGG
           or qType == TYPE_HATCH_CUSTOM_EGG or qType == TYPE_HATCH_RARE_PET) then
            local needed = math.max(0, (g.Amount or 1) - (g.Progress or 0))
            if needed > 0 then
                eggGoal = g
                break
            end
        end
    end
    
    if hasPetQuest and tick() - lastPetConvertTime > 1.5 then
        lastPetConvertTime = tick()
        pcall(executePetConversion)
    end
    
    local needToHatch = false
    local eggsToOpen = 0
    
    local petCount = 0
    pcall(function()
        if v1 and v1.Inventory and v1.Inventory.Pet then
            for _, _ in pairs(v1.Inventory.Pet) do
                petCount = petCount + 1
            end
        end
    end)
    local petSlots = v1 and (v1.MaxPetsEquipped or v1.PetSlots or v1.PetEquipSlots or v1.MaxPetSlots) or 4
    
    local isUnderArea10 = false
    pcall(function()
        local mzName, mzData = getMaxOwnedZoneInCurrentWorld(true)
        if mzData and mzData.ZoneNumber and mzData.ZoneNumber <= 10 then
            isUnderArea10 = true
        end
    end)
    
    if eggGoal then
        local needed = math.max(0, (eggGoal.Amount or 1) - (eggGoal.Progress or 0))
        if needed > 0 then
            needToHatch = true
            eggsToOpen = 99999
        end
    elseif hasPetQuest then
        needToHatch = true
        eggsToOpen = 99999
    elseif getCurrentWorld() == 1 and isUnderArea10 and petCount < petSlots then
        needToHatch = true
        eggsToOpen = petSlots - petCount
    end

    if isInFirst10ZonesOfCurrentWorld() then
        needToHatch = false
        if tick() - lastEggBlockLog > 30 then
            lastEggBlockLog = tick()
        end
    end
    
    local debounce = 0.25
    pcall(function()
        local eggCmdsModule = EggCmds or require(game:GetService("ReplicatedStorage").Library.Client.EggCmds)
        if eggCmdsModule and eggCmdsModule.ComputeDebounce then
            debounce = eggCmdsModule.ComputeDebounce() or 0.25
        end
    end)
    
    if needToHatch and not isHatching and tick() - lastHatchTime > debounce then
        
        if config.AutoDisableChargedGoldenHatch and tick() - lastDisableHatchFlagsTime > 5 then
            lastDisableHatchFlagsTime = tick()
            local HatchingCmds = nil
            local Hatching = nil
            pcall(function()
                HatchingCmds = require(game:GetService("ReplicatedStorage").Library.Client.HatchingCmds)
                Hatching = require(game:GetService("ReplicatedStorage").Library.Types.Hatching)
            end)
            
            local chargedEnabled = true
            local goldenEnabled = true
            if HatchingCmds and Hatching then
                pcall(function()
                    chargedEnabled = HatchingCmds.IsEnabled(Hatching.Options.CHARGED)
                    goldenEnabled = HatchingCmds.IsEnabled(Hatching.Options.GOLDEN)
                end)
