local function autoClickRandomEvents()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local maxZoneName = getMaxOwnedZoneInCurrentWorld()
    local farmPos = maxZoneName and getFarmPosition(maxZoneName)
    if not farmPos then return end

    local function isNearFarm(pos)
        if not pos then return false end
        return (pos - farmPos).Magnitude <= NEAR_FARM_RANGE
    end

    local now = tick()
    local THINGS = cachedThings or workspace:FindFirstChild("__THINGS")
    if not THINGS then return end

    local BreakableFrontend = getBreakableFrontend()

    local function isEventValid(v, nameOrAttribute)
        if not nameOrAttribute then return false end
        local lowerName = string.lower(tostring(nameOrAttribute))
        if string.find(lowerName, "giant", 1, true) then
            return false
        end
        local isMagic = string.find(lowerName, "magic", 1, true)
        local isJar = string.find(lowerName, "jar", 1, true) and not isMagic
        local isComet = string.find(lowerName, "comet", 1, true)
        local isPinata = string.find(lowerName, "pinata", 1, true)
        local isLucky = string.find(lowerName, "lucky", 1, true)
        
        if isJar then
            if v and v:IsA("Model") then
                local mode = nil
                pcall(function() mode = v.ModelStreamingMode end)
                if mode ~= Enum.ModelStreamingMode.Persistent then
                    return false
                end
            end
        end
        return isJar or isComet or isPinata or isLucky
    end

    local eventObjects = {}

    local breakablesFolder = THINGS:FindFirstChild("Breakables")
    if breakablesFolder then
        for _, v in ipairs(breakablesFolder:GetChildren()) do
            local breakableId = v:GetAttribute("BreakableID")
            if isEventValid(v, breakableId) or isEventValid(v, v.Name) then
                local part = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                if part and isNearFarm(part.Position) then
                    local uid = v:GetAttribute("BreakableUID") or v.Name
                    table.insert(eventObjects, {
                        model = v,
                        part = part,
                        uid = tostring(uid),
                        pos = part.Position
                    })
                end
            end
        end
    end

    local randomEventsFolder = THINGS:FindFirstChild("RandomEvents")
    if randomEventsFolder then
        for _, v in ipairs(randomEventsFolder:GetChildren()) do
            local breakableId = v:GetAttribute("BreakableID")
            if isEventValid(v, breakableId) or isEventValid(v, v.Name) then
                local part = v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart")
                if part and isNearFarm(part.Position) then
                    local uid = v:GetAttribute("BreakableUID") or v.Name
                    table.insert(eventObjects, {
                        model = v,
                        part = part,
                        uid = tostring(uid),
                        pos = part.Position
                    })
                end
            end
        end
    end

    for _, v in ipairs(THINGS:GetChildren()) do
        if v:IsA("Model") or v:IsA("BasePart") then
            local breakableId = v:GetAttribute("BreakableID")
            if isEventValid(v, breakableId) or isEventValid(v, v.Name) then
                local part = (v:IsA("Model") and (v.PrimaryPart or v:FindFirstChildWhichIsA("BasePart"))) or v
                if part and isNearFarm(part.Position) then
                    local uid = v:GetAttribute("BreakableUID") or v.Name
                    table.insert(eventObjects, {
                        model = v,
                        part = part,
                        uid = tostring(uid),
                        pos = part.Position
                    })
                end
            end
        end
    end

    if #eventObjects == 0 then return end

    for _, obj in ipairs(eventObjects) do
        local lastDmg = lastEventDamageTime[obj.uid] or 0
        if (now - lastDmg) >= 0.05 then
            pcall(function()
                for i = 1, 5 do
                    fireBreakableClickDamage(obj.uid, obj.model)
                end
            end)
            if BreakableFrontend then
                pcall(function()
                    BreakableFrontend.tryToSendPetToBreakable(obj.uid)
                end)
            end
            lastEventDamageTime[obj.uid] = now
        end
    end
end

local lastVacuumLog = 0

local VACUUM_PATTERNS = {
    "coin", "gem", "diamond", "token", "orb",
    "currency", "pickup", "collect", "dropp", "loot"
}

local function isVacuumTarget(part, THINGS)
    if not part then return false end
    
    if THINGS then
        local orbsFolder = THINGS:FindFirstChild("Orbs")
        local lootbagsFolder = THINGS:FindFirstChild("Lootbags")
        if (orbsFolder and part:IsDescendantOf(orbsFolder)) or (lootbagsFolder and part:IsDescendantOf(lootbagsFolder)) then
            return true
        end
    end
    
    local name = part.Name
    local lower = string.lower(name)
    for _, p in ipairs(VACUUM_PATTERNS) do
        if string.find(lower, p, 1, true) then return true end
    end
    return false
end

local VACUUM_FOLDERS = {"Orbs", "Lootbags"}

local function autoCoinVacuum()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local playerPos = hrp.Position
    local destCF   = hrp.CFrame
    local count    = 0
    local maxItems = config.VacuumMaxItems or 100

    local THINGS = cachedThings or workspace:FindFirstChild("__THINGS")
    
    if THINGS then
        for _, folderName in ipairs(VACUUM_FOLDERS) do
            local folder = THINGS:FindFirstChild(folderName)
            if folder then
                for _, obj in ipairs(folder:GetChildren()) do
                    if count >= maxItems then break end
                    local part = obj:IsA("BasePart") and obj or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")))
                    if part then
                        local dist = (part.Position - playerPos).Magnitude
                        if dist > 3 and dist <= VACUUM_RANGE then
                            if obj:IsA("Model") and obj.PrimaryPart then
                                pcall(function() obj:SetPrimaryPartCFrame(destCF) end)
                            else
                                pcall(function() part.CFrame = destCF end)
                            end
                            count = count + 1
                        end
                    end
                end
            end
        end
    end

    local now = tick()
    if count > 0 and now - lastVacuumLog > 10 then
        lastVacuumLog = now
    end
end

