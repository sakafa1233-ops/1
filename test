            activeCalcEggSlotPrice = require(game:GetService("ReplicatedStorage"):WaitForChild("Library", 5):WaitForChild("Balancing", 5):WaitForChild("CalcEggSlotPrice", 5))
        end)
    end
    
    if not activeCalcPetSlotPrice or not activeCalcEggSlotPrice then
        return false, 0, 0, false, 0, 0
    end
    
    local currentDiamonds = CurrencyCmds.Get("Diamonds") or 0
    
    local canBuyPet = false
    local petCost = 0
    local nextPetSlot = (v1.PetSlotsPurchased or 0) + 1
    local maxPurchasablePet = 0
    if RankCmds then
        pcall(function() maxPurchasablePet = RankCmds.GetMaxPurchasableEquipSlots() or 0 end)
    end
    
    if nextPetSlot <= config.BuyPetSlots and nextPetSlot <= maxPurchasablePet then
        local ok, c = pcall(function() return activeCalcPetSlotPrice(nextPetSlot) end)
        if ok and c then
            petCost = c
            if petCost <= config.MaxUpgradePrice and currentDiamonds >= petCost then
                canBuyPet = true
            end
        end
    end
    
    local canBuyEgg = false
    local eggCost = 0
    local eggBeforePurchased = v1.EggSlotsPurchased or 0
    local eggBeforeUI = eggBeforePurchased + 1
    
    local currentCard = sharedGetEggCardIndex(eggBeforePurchased)
    local nextEggCard = currentCard + 1
    local size = SHARED_EGG_SLOT_SIZES[nextEggCard] or 1
    local nextEggSlotUI = eggBeforeUI + size
    
    if nextEggSlotUI <= config.BuyEggSlots then
        local ok, c = pcall(function() return activeCalcEggSlotPrice(nextEggCard) end)
